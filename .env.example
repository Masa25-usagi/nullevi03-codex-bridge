# BotFather で作成した Bot の token と、許可する Telegram chat_id。
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
TELEGRAM_CHAT_ID=123456789

# Codex を実行する専用作業フォルダー。絶対パスを指定してください。
CODEX_CWD=/absolute/path/to/codex-workspace

# 通常は変更不要です。空欄なら Codex の既定モデル・推論量を使います。
CODEX_BIN=codex
NODE_BIN=node
CODEX_MODEL=
CODEX_EFFORT=

# Telegram long polling の待機秒数（1〜50）。
TELEGRAM_POLL_TIMEOUT_SECONDS=30
